# ============================================================================
# Moodle stack configuration.
#
#   1. Copy this file:        cp .env.example .env
#   2. Edit every REQUIRED value below.
#   3. Start the stack:       docker compose up -d --build
#
# Notes:
#   - .env is ignored by git (see .gitignore). Never commit it: it holds
#     your passwords.
#   - Generate strong passwords with:  openssl rand -base64 24
#   - Avoid the characters  $  "  '  \  and  #  in passwords; they confuse
#     the tools that read this file. The openssl command above is safe.
# ============================================================================

# --- REQUIRED: your web address ---------------------------------------------
# The domain name where your Moodle will live, WITHOUT https:// and WITHOUT
# a trailing slash. Its DNS A record must point at your server's public IP
# before the first start, so Let's Encrypt can issue the HTTPS certificate.
#
# To test on your own computer first, set:  MOODLE_DOMAIN=localhost
MOODLE_DOMAIN=moodle.example.org

# Email address Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=you@example.org

# --- REQUIRED: first admin account (created automatically on first start) ---
# Moodle's password policy applies: at least 8 characters, with at least one
# lowercase letter, one uppercase letter, one digit and one symbol like * or -.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=REPLACE_ME_Adm1n-password
MOODLE_ADMIN_EMAIL=you@example.org

# --- REQUIRED: database passwords (internal; you will rarely type them) -----
DB_PASSWORD=REPLACE_ME_strong_password
DB_ROOT_PASSWORD=REPLACE_ME_strong_root_password

# --- Site identity -----------------------------------------------------------
# Shown in the page header and in emails. Quotes are needed around values
# that contain spaces.
MOODLE_SITE_FULLNAME="My Learning Platform"
MOODLE_SITE_SHORTNAME=Moodle

# IANA timezone name, e.g. Europe/Berlin, Asia/Dili, America/Sao_Paulo.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
MOODLE_TIMEZONE=UTC

# --- Database names (defaults are fine; change only if you have a reason) ---
DB_NAME=moodle
DB_USER=moodle
DB_PREFIX=mdl_

# --- OPTIONAL: outgoing email (SMTP) -----------------------------------------
# Needed for password-reset emails, forum notifications, etc.
# Leave MOODLE_SMTP_HOSTS empty to skip for now — you can fill it in later
# and run `docker compose up -d` again to apply.
#
# Format: host:port, e.g.  smtp.example.org:587
# MOODLE_SMTP_SECURE is "tls" (port 587, most common) or "ssl" (port 465).
#
# WARNING: most cloud providers BLOCK outgoing SMTP by default — see
# "Outgoing email" in README.md.
MOODLE_SMTP_HOSTS=
MOODLE_SMTP_USER=
MOODLE_SMTP_PASSWORD=
MOODLE_SMTP_SECURE=tls
MOODLE_SMTP_AUTH=LOGIN
MOODLE_SMTP_MAXBULK=1

# "From" address for automated emails. Must be an address your SMTP server
# is allowed to send for (matching domain), or recipients will mark it spam.
MOODLE_NOREPLY=noreply@example.org

# --- Build settings (rarely changed) -----------------------------------------
# PHP version of the base image (Moodle 4.5 supports 8.1 - 8.3).
PHP_VERSION=8.3
# Moodle release branch: 405 = 4.5 LTS.
MOODLE_BRANCH=405
# Which tarball to download at build time. The default always fetches the
# newest 4.5.x patch release. To pin an exact version instead, e.g.:
#   MOODLE_TARBALL=moodle-4.5.12.tgz
MOODLE_TARBALL=moodle-latest-405.tgz
# Tag for the locally built images.
IMAGE_TAG=4.5
